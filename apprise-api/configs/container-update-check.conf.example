# Installed as /etc/apprise-container-update-check.conf with mode 0600.
# APPRISE_CONFIG_KEY is a saved Apprise API configuration name, not an API key.
APPRISE_BASE_URL=http://127.0.0.1:8000
APPRISE_CONFIG_KEY=apprise
CONTAINER_UPDATE_REFERENCE_PATH=/home/aaron/code/homelab-notification/apprise-api/docs/CONTAINER_LIFECYCLE.md
CONTAINER_UPDATE_RETRY_ATTEMPTS=4
CONTAINER_UPDATE_RETRY_DELAY_SECONDS=900
CONTAINER_UPDATE_REMINDER_SECONDS=518400
